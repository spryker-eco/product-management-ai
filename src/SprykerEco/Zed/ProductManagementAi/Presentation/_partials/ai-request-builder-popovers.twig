<div class="all-ai-actions-popover modal-popover" popover="manual">
    <div class="modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{{ 'AI assistant' | trans }}</h4>
                    <button type="button" class="btn-close" data-close-popover data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body js-modal-body">
                    <div class="ai-product-management-modal__content">
                        <h3 class="ai-query-builder__subtitle">Please select one of the following options.</h3>

                        <button type="button" class="ai-query-builder__button"
                                data-target-popover=".translation-actions-popover"
                                data-request-action="translation"
                                data-request-url="/product-management-ai/translate">
                            {{ languageIcon | raw }}
                            {{ 'Translate content' | trans }}
                        </button>
                        <button type="button"
                            class="ai-query-builder__button"
                            data-request-action="improve-description"
                            data-request-url="/product-management-ai/content-improver"
                            data-request-ready>
                            {{ improveIcon | raw }}
                            Improve content
                        </button>
                    </div>
                </div>

                <div class="modal-footer ai-product-management-modal__actions">
                    <div class="modal-actions">
                        <button type="button"
                                class="js-ai-product-management-again btn btn-outline btn-view">{{ 'Try again' | trans }}</button>
                        <button type="button"
                                class="js-ai-product-management-apply btn">{{ 'Apply' | trans }}</button>
                    </div>
                </div>
            </div>
        </div>

        <button type="button" tabindex="-1" class="modal-backdrop"></button>
    </div>
</div>

<div class="translation-actions-popover modal-popover" popover="manual">
    <div class="modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{{ 'AI assistant' | trans }}</h4>
                    <button type="button" class="btn-close" data-close-popover data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body js-modal-body">
                    <div class="ai-product-management-modal__content">
                        <h3 class="ai-query-builder__subtitle">Please select one of the following options.</h3>
                        {% for locale in localeCollection %}
                            <button type="button" class="ai-query-builder__button"
                                    data-request-target-locale="{{ locale.localeName }}"
                                    data-request-ready>
                                        {{ languageIcon | raw }}
                                        {{ locale.localeName }}
                                    </button>
                        {% endfor %}
                    </div>
                </div>

                <div class="modal-footer ai-product-management-modal__actions">
                    <div class="modal-actions">
                        <button type="button"
                                class="js-ai-product-management-again btn btn-outline btn-view">{{ 'Try again' | trans }}</button>
                        <button type="button"
                                class="js-ai-product-management-apply btn">{{ 'Apply' | trans }}</button>
                    </div>
                </div>
            </div>
        </div>

        <button type="button" tabindex="-1" class="modal-backdrop"></button>
    </div>
</div>

<div class="loading-popover modal-popover ai-product-management-modal is-loading" popover="manual">
    <div class="modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{{ 'AI assistant' | trans }}</h4>
                    <button type="button" class="btn-close" data-close-popover data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body js-modal-body">
                    <div class="ai-product-management-modal__loading">
                        <span>{{ 'AI is processing your request' | trans }}</span>
                        <span class="fa fa-spinner fa-spin"></span>
                    </div>
                </div>
            </div>
        </div>

        <button type="button" tabindex="-1" class="modal-backdrop"></button>
    </div>
</div>

<div class="response-popover modal-popover" popover="manual">
    <div class="modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{{ 'AI assistant' | trans }}</h4>
                    <button type="button" class="btn-close" data-close-popover data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body js-modal-body">
                     {% block loading %}
                        <div class="ai-product-management-modal__loading">
                            <span>{{ 'AI is processing your request' | trans }}</span>
                            <span class="fa fa-spinner fa-spin"></span>
                        </div>
                    {% endblock %}

                    <div class="ai-product-management-modal__error-block js-ai-product-management-modal__error-block alert alert-warning mb-2"></div>

                    <div class="row">
                        <div class="col-6">
                            <h3 class="ai-query-builder__subtitle">Original</h3>
                            <textarea id="original-field" class="form-control" name="" id="" cols="30" rows="10"></textarea>
                        </div>
                        <div class="col-6">
                            <h3 class="ai-query-builder__subtitle">Suggestion</h3>
                            <textarea id="response-field" class="form-control" name="" id="" cols="30" rows="10"></textarea>
                        </div>
                    </div>
                </div>

            
                <div class="modal-footer ai-product-management-modal__actions">
                    <div class="modal-actions">
                        <button type="button" class="js-ai-builder-again btn btn-outline btn-view">{{ 'Try again' | trans }}</button>
                        <button type="button" class="js-ai-builder-apply btn">{{ 'Apply' | trans }}</button>
                    </div>
                </div>  
            </div>
        </div>

        <button type="button" tabindex="-1" class="modal-backdrop"></button>
    </div>
</div>

<script src="{{ assetsPath('js/ai-request-builder.js') }}"></script>
<link rel="stylesheet" href="{{ assetsPath('css/ai-request-builder.css') }}" />