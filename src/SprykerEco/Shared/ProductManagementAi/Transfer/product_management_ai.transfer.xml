<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="ProductImage">
        <property name="altText" type="string" strict="true"/>
    </transfer>

    <transfer name="ProductImageStorage">
        <property name="altText" type="string" strict="true"/>
    </transfer>

    <transfer name="AiTranslatorResponse" strict="true">
        <property name="originalText" type="string"/>
        <property name="sourceLocale" type="string"/>
        <property name="targetLocale" type="string"/>
        <property name="translation" type="string"/>
        <property name="isSuccessful" type="bool"/>
        <property name="errors" type="Error[]" singular="error"/>
    </transfer>

    <transfer name="AiTranslatorRequest" strict="true">
        <property name="text" type="string"/>
        <property name="sourceLocale" type="string"/>
        <property name="targetLocale" type="string"/>
        <property name="invalidateCache" type="bool"/>
    </transfer>

    <transfer name="Category">
        <property name="idCategory" type="int"/>
        <property name="name" type="string"/>
    </transfer>

    <transfer name="CategoryCollection">
        <property name="categories" type="Category[]" singular="category"/>
    </transfer>

    <transfer name="ProductAbstract">
        <property name="categoryIds" type="int[]" singular="idCategory"/>
    </transfer>

    <transfer name="Locale">
        <property name="localeName" type="string"/>
    </transfer>

    <transfer name="PromptRequest" strict="true">
        <property name="promptMessage" type="PromptMessage"/>
        <property name="aiConfigurationName" type="string" description="The configuration name of ai configuration"/>
    </transfer>

    <transfer name="PromptResponse">
        <property name="message" type="PromptMessage"/>
    </transfer>

    <transfer name="PromptMessage">
        <property name="content" type="string"/>
        <property name="contentData" type="array" singular="contentData"/>
        <property name="attachments" type="Attachment[]" singular="attachment"/>
    </transfer>

    <transfer name="Attachment">
        <property name="type" type="string"/>
        <property name="content" type="string"/>
        <property name="contentType" type="string"/>
        <property name="mediaType" type="string"/>
    </transfer>

    <transfer name="CategorySuggestionRequest" strict="true">
        <property name="productName" type="string"/>
        <property name="productDescription" type="string"/>
    </transfer>

    <transfer name="CategorySuggestionResponse" strict="true">
        <property name="suggestions" type="CategorySuggestionItem[]" singular="suggestion"/>
        <property name="isSuccessful" type="bool"/>
        <property name="errors" type="Error[]" singular="error"/>
    </transfer>

    <transfer name="CategorySuggestionItem" strict="true">
        <property name="categoryId" type="int" description="The unique identifier of the category from the existing category list"/>
        <property name="categoryName" type="string" description="The name of the category that matches the product"/>
    </transfer>

    <transfer name="CategorySuggestionStructured" strict="true">
        <property name="categories" type="CategorySuggestionItem[]" singular="category" description="List of suggested categories that best fit the product based on its name and description"/>
    </transfer>

    <transfer name="AiTranslationStructured" strict="true">
        <property name="translation" type="string" description="The translated text in the target locale"/>
    </transfer>

    <transfer name="ImageAltTextRequest" strict="true">
        <property name="imageUrl" type="string"/>
        <property name="targetLocale" type="string"/>
    </transfer>

    <transfer name="ImageAltTextResponse" strict="true">
        <property name="altText" type="string"/>
        <property name="isSuccessful" type="bool"/>
        <property name="errors" type="Error[]" singular="error"/>
    </transfer>

    <transfer name="ImageAltTextStructured" strict="true">
        <property name="altText" type="string" description="The generated alt text for the image optimized for SEO"/>
    </transfer>

    <transfer name="ContentImproverRequest" strict="true">
        <property name="text" type="string"/>
        <property name="invalidateCache" type="bool"/>
    </transfer>

    <transfer name="ContentImproverResponse" strict="true">
        <property name="originalText" type="string"/>
        <property name="improvedText" type="string"/>
        <property name="isSuccessful" type="bool"/>
        <property name="errors" type="Error[]" singular="error"/>
    </transfer>

    <transfer name="ContentImproverStructured" strict="true">
        <property name="improvedText" type="string" description="The improved and enhanced version of the original text with better clarity, grammar, and structure"/>
    </transfer>

</transfers>
